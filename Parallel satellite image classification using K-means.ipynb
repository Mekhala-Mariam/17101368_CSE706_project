    "## Building the CNN Model\n",
    "\n",
    "Now we define a **Convolutional Neural Network (CNN)** to classify satellite images into their respective categories.\n",
    "\n",
    "### Model Architecture\n",
    "The model uses a **Sequential** structure consisting of:\n",
    "- **Convolutional layers (Conv2D)** for feature extraction  \n",
    "- **Batch Normalization** to stabilize and speed up training  \n",
    "- **MaxPooling** layers for spatial dimension reduction  \n",
    "- **Dropout layers** to prevent overfitting  \n",
    "- **Global Average Pooling** for dimensionality reduction  \n",
    "- **Dense layers** for final classification using a softmax activation  \n",
    "\n",
    "### Callbacks for Optimization\n",
    "We use several callbacks to improve training efficiency:\n",
    "- **EarlyStopping** → stops training when validation loss stops improving  \n",
    "- **ModelCheckpoint** → saves the best model during training  \n",
    "- **ReduceLROnPlateau** → reduces learning rate when validation loss stagnates  \n",
    "\n",
    "Finally, the model is compiled using:\n",
    "- **Optimizer:** `Adam` with a learning rate of 0.0005  \n",
    "- **Loss function:** `categorical_crossentropy`  \n",
    "- **Metrics:** `accuracy`\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2025-11-12T11:15:42.788318Z",
     "iopub.status.busy": "2025-11-12T11:15:42.788159Z",
     "iopub.status.idle": "2025-11-12T11:15:42.840577Z",
     "shell.execute_reply": "2025-11-12T11:15:42.839805Z",
     "shell.execute_reply.started": "2025-11-12T11:15:42.788302Z"
    },
    "id": "t1NkbzN_J5r3",
    "outputId": "337154ed-0201-4bd8-89c8-df7c373218d2"
   },
   "outputs": [],
   "source": [
    "model = models.Sequential([\n",
    "    layers.Conv2D(32, (3, 3), activation = 'relu', input_shape=(150,150,3)),\n",
    "    layers.BatchNormalization(),\n",
    "    layers.MaxPooling2D(2, 2),\n",
    "\n",
    "    layers.Conv2D(64, (3,3), activation = 'relu'),\n",
    "    layers.BatchNormalization(),\n",
    "    layers.MaxPooling2D(2,2),\n",
    "\n",
    "    layers.Conv2D(128, (3,3), activation = 'relu'),\n",
    "    layers.BatchNormalization(),\n",
    "    layers.MaxPooling2D(2,2),\n",
    "    layers.Dropout(0.3),\n",
    "\n",
    "    layers.GlobalAveragePooling2D(),\n",
    "    layers.Dense(128, activation = 'relu'),\n",
    "    layers.Dropout(0.5),\n",
    "    layers.Dense(train.num_classes, activation='softmax')\n",
    "])\n",
    "\n",
    "model.compile(\n",
    "    optimizer = Adam(learning_rate=0.0005),\n",
    "    loss = 'categorical_crossentropy',\n",
    "    metrics = (['accuracy'])\n",
    ")import os\n",
    "import time\n",
    "import glob\n",
    "import numpy as np\n",
    "from PIL import Image\n",
    "from skimage.feature import graycomatrix, graycoprops\n",
    "from multiprocessing import Pool, cpu_count\n",
    "\n",
    "# Define image feature extraction function (Embarrassingly Parallel Unit)\n",
    "def process_single_image(image_path):\n",
    "    try:\n",
    "        # Load image and convert to grayscale for GLCM texture analysis\n",
    "        img = Image.open(image_path).convert('L')\n",
    "        img_arr = np.array(img)\n",
    "        \n",
    "        # Calculate GLCM\n",
    "        glcm = graycomatrix(img_arr, distances=[1], angles=[0], levels=256, symmetric=True, normed=True)\n",
    "        \n",
    "        # Extract texture properties\n",
    "        contrast = graycoprops(glcm, 'contrast')[0, 0]\n",
    "        dissimilarity = graycoprops(glcm, 'dissimilarity')[0, 0]\n",
    "        homogeneity = graycoprops(glcm, 'homogeneity')[0, 0]\n",
    "        energy = graycoprops(glcm, 'energy')[0, 0]\n",
    "        correlation = graycoprops(glcm, 'correlation')[0, 0]\n",
    "        \n",
    "        # Color stats\n",
    "        mean_intensity = np.mean(img_arr)\n",
    "        std_intensity = np.std(img_arr)\n",
    "        \n",
    "        return [contrast, dissimilarity, homogeneity, energy, correlation, mean_intensity, std_intensity]\n",
    "    except Exception as e:\n",
    "        return None\n",
    "\n",
    "# Function to run processing using N CPU cores\n",
    "def execute_parallel_pipeline(image_list, num_cores):\n",
    "    start_time = time.time()\n",
    "    \n",
    "    # Process using Python multiprocessing pool pinned to 'num_cores'\n",
    "    with Pool(processes=num_cores) as pool:\n",
    "        results = pool.map(process_single_image, image_list)\n",
    "        \n",
    "    execution_time = time.time() - start_time\n",
    "    # Filter out failed images\n",
    "    valid_results = [r for r in results if r is not None]\n",
    "    \n",
    "    return execution_time, len(valid_results)\n",
    "\n",
    "if __name__ == '__main__':\n",
    "    # Update path to your Kaggle dataset directory\n",
    "    DATASET_PATH = \"./data/*/*.jpg\" \n",
    "    image_paths = glob.glob(DATASET_PATH)\n",
    "    \n",
    "    print(f\"Total dataset size found: {len(image_paths)} images.\\n\")\n",
    "    \n",
    "    results_summary = {}\n",
    "    \n",
    "    # Benchmark across 1, 2, 3, and 4 cores\n",
    "    for cores in [1, 2, 3, 4]:\n",
    "        print(f\"--- Running processing on {cores} Core(s) ---\")\n",
    "        exec_time, processed_count = execute_parallel_pipeline(image_paths, num_cores=cores)\n",
    "        results_summary[cores] = exec_time\n",
    "        print(f\"Time Taken on {cores} Core(s): {exec_time:.2f} seconds\")\n",
    "        print(f\"Processing Speed: {processed_count / exec_time:.2f} images/sec\\n\")"
   ]
  },
